{# Prominent LINE inquiry. Caller sets lineCtaLocation. Optional: lineCtaLead, lineCtaFacts, lineCtaCompact. #}
<aside class="line-cta{% if lineCtaCompact %} line-cta--compact{% endif %} glass" aria-label="用 LINE 詢問檔期">
  {% if lineCtaLead %}<p class="line-cta__lead">{{ lineCtaLead }}</p>{% endif %}
  <p class="line-cta__facts">{% if lineCtaFacts %}{{ lineCtaFacts }}{% else %}{{ site.serviceFacts }}{% endif %}</p>
  <a class="line-cta__btn" data-line-location="{{ lineCtaLocation }}" href="https://lin.ee/xcqRIdT" target="_blank" rel="noopener noreferrer">用 LINE 詢問檔期</a>
</aside>
