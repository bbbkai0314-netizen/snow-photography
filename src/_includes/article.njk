{%- set htmlTitle = seo.title or (title + "｜SnowSurfStudio") -%}
{%- set socialTitle = seo.title or title -%}
{%- set canonicalUrl = "https://snowsurfstudio.net/blog/" + page.fileSlug + ".html" -%}
{%- set ogImageUrl = "https://snowsurfstudio.net/" + ((seo.ogImage or heroImage) | encodeUri) -%}
{%- set cluster = blogClusters.clusters | clusterOf(page.fileSlug) -%}
{%- set postKeywords = blogClusters.keywords[page.fileSlug] -%}
{%- set ogType = "article" -%}
{%- set assetPrefix = "../" -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{ canonicalUrl }}#article",
      "headline": {{ title | dump | safe }},
      "description": {{ seo.description | dump | safe }},
      "image": "{{ ogImageUrl }}",
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ (dateModified or date) | isoDate }}",
      "inLanguage": "zh-Hant",
      {%- if cluster %}
      "articleSection": {{ cluster.name | dump | safe }},
      {%- endif %}
      {%- if postKeywords %}
      "keywords": {{ ([postKeywords.primary].concat(postKeywords.secondary)) | join(",") | dump | safe }},
      {%- endif %}
      "author": { "@type": "Organization", "name": "SnowSurfStudio", "url": "https://snowsurfstudio.net/" },
      "publisher": { "@type": "Organization", "@id": "https://snowsurfstudio.net/#organization", "name": "SnowSurfStudio", "url": "https://snowsurfstudio.net/" },
      "mainEntityOfPage": "{{ canonicalUrl }}"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": "https://snowsurfstudio.net/" },
        { "@type": "ListItem", "position": 2, "name": "滑雪日誌", "item": "https://snowsurfstudio.net/blog/index.html" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ canonicalUrl }}" }
      ]
    }
  ]
}
</script>
</head>
<body data-content-name="{{ title }}" data-content-type="article">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M5MVCP2M"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

{% include "partials/glow.njk" %}

{% include "partials/nav.njk" %}

{% include "partials/line-float.njk" %}

<main>
  <article>
    <div class="article-hero">
      <a class="article-breadcrumb" href="index.html">← 返回滑雪日誌</a>
      <span class="article-hero__tag">{{ tag }}</span>
      <h1>{{ displayTitle | safe if displayTitle else title }}</h1>
      <p class="article-hero__meta">{{ metaLine }}</p>
    </div>

    <div class="article-body">
      {% if leadParagraph %}<p class="article-body__lead">{{ leadParagraph }}</p>{% endif %}

      {% for block in contentBlocks %}
        {% if block.type == "html" %}
        <div class="article-section">
          {{ block.html | safe }}
        </div>
        {% elif block.image %}
        <div class="article-block{% if block.imagePosition == 'right' %} article-block--reverse{% endif %}">
          <div class="article-block__media">
            <img src="{{ assetPrefix }}{{ block.image }}" alt="{{ block.imageAlt }}" loading="lazy">
          </div>
          <div class="article-block__text">
            <h2>{{ block.heading }}</h2>
            {% for p in block.paragraphs %}<p>{{ p }}</p>{% endfor %}
            {% if block.items and block.items.length %}
            <ul>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
            {% endif %}
            {% for p in block.trailingParagraphs %}<p>{{ p }}</p>{% endfor %}
          </div>
        </div>
        {% else %}
        <div class="article-section">
          <h2>{{ block.heading }}</h2>
          {% for p in block.paragraphs %}<p>{{ p }}</p>{% endfor %}
          {% if block.items and block.items.length %}
          <ul>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
          {% endif %}
          {% for p in block.trailingParagraphs %}<p>{{ p }}</p>{% endfor %}
        </div>
        {% endif %}
      {% endfor %}

      {% if not hideDefaultCta %}<div class="article-cta glass-panel">
        <p>如果你也想在日本滑雪旅行中留下自然又有質感的回憶，歡迎查看日本滑雪攝影方案與可預約檔期。</p>
        <div class="article-cta__links">
          <a class="article-cta__btn glass" href="../index.html#booking">查看預約方案 →</a>
          <a href="../hakuba-photography/">白馬滑雪攝影</a>
          <a href="../faq.html">常見問題</a>
        </div>
      </div>{% endif %}
    </div>
  </article>

  {% if cluster %}
  <aside class="article-related" aria-labelledby="related-title">
    <p class="article-related__eyebrow">{{ cluster.en }}</p>
    <h2 class="article-related__title" id="related-title">同主題文章｜{{ cluster.name }}</h2>
    <div class="journal__grid">
      {% for related in collections.posts | relatedInCluster(cluster, page.fileSlug, 3) %}
      <a class="journal-card journal-card--text glass" href="{{ related.fileSlug }}.html">
        <div class="journal-card__body">
          <span class="journal-card__tag">{{ related.data.tag }}</span>
          <h3>{{ related.data.title }}</h3>
          <p>{{ related.data.previewDescription }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
    <p class="article-related__service">{{ cluster.serviceLead }}<a href="../hakuba-photography/">{{ (postKeywords and postKeywords.serviceAnchor) or cluster.serviceAnchor }}</a>。其他文章請看<a href="index.html#{{ cluster.id }}">{{ cluster.name }}文章總覽</a>。</p>
  </aside>
  {% endif %}
</main>

{% include "partials/footer.njk" %}

<script src="../js/script.js?v={{ assetVersion }}"></script>
<script src="../js/tracking.js?v={{ assetVersion }}"></script>
</body>
</html>
