{%- set htmlTitle = seo.title or (title + "｜SnowSurfStudio") -%}
{%- set socialTitle = seo.title or title -%}
{%- set canonicalUrl = "https://bbbkai0314-netizen.github.io/snow-photography/blog/" + page.fileSlug + ".html" -%}
{%- set ogImageUrl = "https://bbbkai0314-netizen.github.io/snow-photography/" + (seo.ogImage or heroImage) -%}
{%- set ogType = "article" -%}
{%- set assetPrefix = "../" -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ seo.description }}",
  "image": "{{ ogImageUrl }}",
  "datePublished": "{{ date }}",
  "dateModified": "{{ dateModified or date }}",
  "inLanguage": "zh-Hant",
  "author": { "@type": "Organization", "name": "SnowSurfStudio" },
  "publisher": { "@type": "Organization", "name": "SnowSurfStudio", "url": "https://bbbkai0314-netizen.github.io/snow-photography/" },
  "mainEntityOfPage": "{{ canonicalUrl }}"
}
</script>
</head>
<body>

{% include "partials/glow.njk" %}

<header class="nav glass" id="nav">
  <a class="nav__logo" href="../index.html#top">SnowSurfStudio</a>
  <nav class="nav__links">
    <a href="../index.html#gallery">WORK</a>
    <a href="../index.html#about">ABOUT</a>
    <a href="index.html">JOURNAL</a>
    <a href="../index.html#booking">BOOKING</a>
    <a href="../index.html#contact">CONTACT</a>
  </nav>
</header>

<main>
  <article>
    <div class="article-hero">
      <a class="article-breadcrumb" href="index.html">← 返回文章列表</a>
      <span class="article-hero__tag">{{ tag }}</span>
      <h1>{{ title }}</h1>
      <p class="article-hero__meta">{{ metaLine }}</p>
      <div class="article-hero__image">
        <img src="{{ assetPrefix }}{{ heroImage }}" alt="{{ heroImageAlt }}" loading="lazy">
      </div>
    </div>

    <div class="article-body">
      <p class="article-body__lead">{{ leadParagraph }}</p>

      <div class="article-section">
        {{ content | safe }}
      </div>

      <div class="article-cta glass-panel">
        <p>如果你也想在日本滑雪旅行中留下自然又有質感的回憶，歡迎查看日本滑雪攝影方案與可預約檔期。</p>
        <a class="article-cta__btn glass" href="../index.html#booking">查看預約方案 →</a>
      </div>
    </div>
  </article>
</main>

{% include "partials/footer.njk" %}

<script src="../js/script.js?v={{ assetVersion }}"></script>
</body>
</html>
