{%- set htmlTitle = seo.title or (title + "｜SnowSurfStudio") -%}
{%- set socialTitle = seo.title or title -%}
{%- set canonicalUrl = "https://snowsurfstudio.net/blog/" + page.fileSlug + ".html" -%}
{%- set ogImageUrl = "https://snowsurfstudio.net/" + (seo.ogImage or heroImage) -%}
{%- set ogType = "article" -%}
{%- set assetPrefix = "../" -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ seo.description }}",
  "image": "{{ ogImageUrl }}",
  "datePublished": "{{ date }}",
  "dateModified": "{{ dateModified or date }}",
  "inLanguage": "zh-Hant",
  "author": { "@type": "Organization", "name": "SnowSurfStudio" },
  "publisher": { "@type": "Organization", "name": "SnowSurfStudio", "url": "https://snowsurfstudio.net/" },
  "mainEntityOfPage": "{{ canonicalUrl }}"
}
</script>
</head>
<body>

{% include "partials/glow.njk" %}

{% include "partials/nav.njk" %}

<main>
  <article>
    <div class="article-hero">
      <a class="article-breadcrumb" href="index.html">← 返回滑雪日誌</a>
      <span class="article-hero__tag">{{ tag }}</span>
      <h1>{{ title }}</h1>
      <p class="article-hero__meta">{{ metaLine }}</p>
    </div>

    <div class="article-body">
      <p class="article-body__lead">{{ leadParagraph }}</p>

      {% for block in contentBlocks %}
        {% if block.type == "html" %}
        <div class="article-section">
          {{ block.html | safe }}
        </div>
        {% else %}
        <div class="article-section">
          <h2>{{ block.heading }}</h2>
          {% for p in block.paragraphs %}<p>{{ p }}</p>{% endfor %}
          {% if block.items and block.items.length %}
          <ul>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
          {% endif %}
          {% for p in block.trailingParagraphs %}<p>{{ p }}</p>{% endfor %}
        </div>
        {% endif %}
      {% endfor %}

      <div class="article-cta glass-panel">
        <p>如果你也想在日本滑雪旅行中留下自然又有質感的回憶，歡迎查看日本滑雪攝影方案與可預約檔期。</p>
        <div class="article-cta__links">
          <a class="article-cta__btn glass" href="../index.html#booking">查看預約方案 →</a>
          <a href="../hakuba-photography/">白馬滑雪攝影</a>
          <a href="../faq.html">常見問題</a>
        </div>
      </div>
    </div>
  </article>
</main>

{% include "partials/footer.njk" %}

<script src="../js/script.js?v={{ assetVersion }}"></script>
</body>
</html>
