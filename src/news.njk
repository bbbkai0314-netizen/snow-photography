---
permalink: "news.html"
---
{%- set htmlTitle = "最新消息｜SnowSurfStudio" -%}
{%- set socialTitle = htmlTitle -%}
{%- set canonicalUrl = "https://snowsurfstudio.net/news.html" -%}
{%- set ogImageUrl = "https://snowsurfstudio.net/" + site.seo.ogImage -%}
{%- set ogType = "website" -%}
{%- set assetPrefix = "" -%}
{%- set seo = { description: "SnowSurfStudio 最新消息與優惠公告。", keywords: "SnowSurfStudio 最新消息,滑雪攝影優惠" } -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M5MVCP2M"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

{% include "partials/glow.njk" %}

{% include "partials/nav.njk" %}

<main>
  <section class="news-page" id="news">
    <a class="article-breadcrumb" href="index.html#top">← 返回首頁</a>
    <div class="section-head"><h1>最新消息</h1><p>News</p></div>
    <ul class="news-list">
      {% for item in site.newsItems %}
      <li class="news-list__item glass">
        <h3>{{ item.title }}</h3>
        <ul class="news-list__points">
          {% for point in item.copy %}
          <li>{{ point }}</li>
          {% endfor %}
        </ul>
      </li>
      {% endfor %}
    </ul>

    {% set ctaMessage = "看到喜歡的優惠了嗎？填寫需求表單，告訴我們你的方案與拍攝日期。" %}
    {% include "partials/cta-booking.njk" %}
  </section>

  {% include "partials/footer.njk" %}
</main>

{% include "partials/line-float.njk" %}

<script src="js/script.js?v={{ assetVersion }}"></script>
<script src="js/tracking.js?v={{ assetVersion }}"></script>
</body>
</html>
