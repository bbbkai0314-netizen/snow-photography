{%- set ogImageUrl = "https://bbbkai0314-netizen.github.io/snow-photography/" + site.seo.ogImage -%}
{%- set ogType = "website" -%}
{%- set assetPrefix = "" -%}
{%- set seo = { description: "SnowSurfStudio 最新消息與優惠公告。", keywords: "SnowSurfStudio 最新消息,滑雪攝影優惠" } -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
</head>
<body>

{% include "partials/glow.njk" %}

{% include "partials/nav.njk" %}

<main>
  <section class="news-page" id="news">
    <a class="article-breadcrumb" href="index.html#top">← 返回首頁</a>
    <div class="section-head"><h1>最新消息</h1><p>News</p></div>
    <ul class="news-list">
      {% for item in site.newsItems %}
