{%- set htmlTitle = "文章 Journal｜滑雪攝影教學、比較與雪場攻略 - SnowSurfStudio" -%}
{%- set socialTitle = "文章 Journal｜滑雪攝影教學、比較與雪場攻略" -%}
{%- set canonicalUrl = "https://bbbkai0314-netizen.github.io/snow-photography/blog/index.html" -%}
{%- set ogImageUrl = "https://bbbkai0314-netizen.github.io/snow-photography/images/action-01.jpg" -%}
{%- set ogType = "website" -%}
{%- set assetPrefix = "../" -%}
{%- set seo = { description: "滑雪攝影相關教學、比較與雪場攻略文章，寫給正在規劃日本滑雪行程的你。滑雪拍照姿勢、自拍與專業攝影比較、雪場拍攝攻略。", keywords: "滑雪攝影,滑雪拍照教學,湯澤滑雪攝影,滑雪攝影推薦" } -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
</head>
<body>

{% include "partials/glow.njk" %}

<header class="nav glass" id="nav">
  <a class="nav__logo" href="../index.html#top">SnowSurfStudio</a>
  <nav class="nav__links">
    <a href="../index.html#gallery">WORK</a>
    <a href="../about.html">ABOUT</a>
    <a href="index.html">JOURNAL</a>
    <a href="../index.html#booking">BOOKING</a>
    <a href="../index.html#contact">CONTACT</a>
  </nav>
</header>

<main>
  <div class="blog-hero">
    <h1>文章 Journal</h1>
    <p>滑雪攝影的準備、比較與雪場攻略，寫給正在規劃日本滑雪行程的你。</p>
  </div>

  <section class="blog-grid-section">
    <div class="journal__grid">
      {% for post in collections.posts | reverse %}
      <a class="journal-card glass" href="{{ post.fileSlug }}.html">
        <img src="../{{ post.data.previewImage or post.data.heroImage }}" alt="{{ post.data.previewImageAlt or post.data.heroImageAlt }}" loading="lazy">
        <div class="journal-card__body">
          <span class="journal-card__tag">{{ post.data.tag }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.previewDescription }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
</main>

{% include "partials/footer.njk" %}

<script src="../js/script.js?v={{ assetVersion }}"></script>
</body>
</html>
