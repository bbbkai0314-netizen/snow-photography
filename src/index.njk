{%- set htmlTitle = site.seo.title -%}
{%- set socialTitle = site.seo.title -%}
{%- set canonicalUrl = "https://bbbkai0314-netizen.github.io/snow-photography/" -%}
{%- set ogImageUrl = "https://bbbkai0314-netizen.github.io/snow-photography/" + site.seo.ogImage -%}
{%- set ogType = "website" -%}
{%- set assetPrefix = "" -%}
{%- set seo = site.seo -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
<meta name="author" content="SnowSurfStudio">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SnowSurfStudio",
  "alternateName": "滑雪攝影 SnowSurfStudio",
  "description": "SnowSurfStudio 提供日本新潟越後湯澤、長野白馬等地的滑雪攝影與滑雪跟拍服務，捕捉滑雪旅行中的動作、人像與生活紀錄。",
  "url": "https://bbbkai0314-netizen.github.io/snow-photography/",
  "image": "{{ ogImageUrl }}",
  "email": "bbbkai0314@gmail.com",
  "areaServed": [
    { "@type": "Place", "name": "日本新潟・越後湯澤" },
    { "@type": "Place", "name": "長野・白馬" },
    { "@type": "Place", "name": "北海道" }
  ],
  "sameAs": [
    "https://www.instagram.com/snowsurfstudio"
  ],
  "inLanguage": "zh-Hant"
}
</script>
</head>
<body>

{% include "partials/glow.njk" %}

<header class="nav glass" id="nav">
  <a class="nav__logo" href="#top">SnowSurfStudio</a>
  <nav class="nav__links">
    <a href="#about">關於</a>
    <a href="#news">最新消息</a>
    <a href="#gallery">作品</a>
    <a href="#plans">方案</a>
    <div class="nav__item nav__item--dropdown" id="navBookingDropdown">
      <button type="button" class="nav__dropdown-trigger" aria-expanded="false" aria-controls="navBookingMenu">
        我要預約<span class="nav__caret" aria-hidden="true">▾</span>
      </button>
      <div class="nav__dropdown-menu" id="navBookingMenu">
        <a href="#booking">📋 預約流程</a>
        <a href="#policies">🛡️ 安心預約規則</a>
        <a href="#faq">💬 常見問題</a>
      </div>
    </div>
    <a href="#contact">聯絡</a>
  </nav>
</header>

<aside class="side-card glass" id="sideCard">
  <div class="side-card__dots" id="sideDots"></div>
  <div class="side-card__label" id="sideLabel">HERO</div>
</aside>

<main id="top">

  <section class="chapter" data-tag="HERO" style="--h:100vh">
    <div class="chapter__pin">
      <div class="chapter__media">
        <img src="images/action-01.jpg" alt="滑雪板騰空動作">
      </div>
      <div class="chapter__scrim chapter__scrim--hero"></div>
      <div class="chapter__content chapter__content--hero">
        <p class="eyebrow">SNOW PHOTOGRAPHY SERVICES</p>
        <h1>SnowSurfStudio</h1>
        <p class="chapter__location">{{ site.heroLocationLine }}</p>
        <p class="chapter__sub">2026 / 27 Season &middot; @snowsurfstudio</p>
      </div>
      <div class="scroll-cue">SCROLL</div>
    </div>
  </section>

  {% if site.newsBanner.active %}
  <section class="news-banner" id="news" aria-labelledby="news-title">
    <div class="news-banner__card glass">
      <span class="news-banner__eyebrow">最新消息 · NEWS</span>
      <h2 id="news-title">{{ site.newsBanner.title }}</h2>
      <p>{{ site.newsBanner.copy }}</p>
      <a class="news-banner__btn appointment__btn glass" href="#booking">{{ site.newsBanner.buttonLabel }}</a>
    </div>
  </section>
  {% endif %}

  <section class="about glass-panel" id="about">
    <div class="section-head">
      <h2>關於</h2>
      <p>About</p>
    </div>
    <div class="about__inner">
      <h3 class="about__brand">SnowSurfStudio</h3>
      <p class="about__lead">{{ site.aboutLead }}</p>
      <p>SnowSurfStudio 專注於滑雪文化影像創作，透過鏡頭捕捉每一次滑行的速度、線條與情感。</p>
      <p>我們相信，滑雪不只是完成一個動作，而是與雪山、地形及自然共舞的過程。每一次轉彎、每一道雪花揚起，都是獨一無二的故事。</p>
      <p>無論是粉雪、樹林、Carving、Park，或是日出與夕陽下的滑行，我們希望用影像保留每位滑雪者最真實、最自由的瞬間。</p>
      <p>不只是滑雪風格，更是一種生活態度。我們希望透過影像，讓每位滑雪者在多年後回頭看見照片時，依然能想起那一天的雪況、速度，以及當下最純粹的快樂。</p>
    </div>
  </section>

  <section class="chapter" data-tag="01 — POWDER" style="--h:180vh">
    <div class="chapter__pin">
      <div class="chapter__media chapter__media--top">
        <img src="images/action-02.jpg" alt="雙人跳躍動作">
      </div>
      <div class="chapter__scrim"></div>
      <div class="chapter__content glass-card chapter__content--right">
        <span class="chapter__tag">01 — POWDER</span>
        <h2>Powder Jump</h2>
        <p>粉雪炸開的瞬間，是整個雪季最誠實的表情。</p>
      </div>
    </div>
  </section>

  <section class="about glass-panel">
    <div class="about__block" style="margin-top:0; padding-top:0; border-top:none;">
      <div class="about__row">
        <div class="about__col">
          <h4>服務內容</h4>
          <ul class="about__list">
            <li>❄️ 個人滑雪寫真</li>
            <li>🎿 Snowboard／Ski</li>
            <li>👨‍👩‍👧 家庭與朋友滑雪紀錄</li>
            <li>🏔 品牌形象攝影</li>
            <li>🧥 滑雪裝備品牌合作</li>
            <li>🏂 教練課程紀錄</li>
          </ul>
        </div>

        <div class="about__col">
          <h4>拍攝風格</h4>
          <p>不同於制式觀光照，我們更重視：</p>
          <ul class="about__list about__list--plain">
            <li>自然滑行姿態</li>
            <li>光影與雪景氛圍</li>
            <li>真實情緒紀錄</li>
            <li>速度感與流動感</li>
          </ul>
          <p>希望每一張照片，都像電影中的一個畫面。</p>
        </div>

        <div class="about__col">
          <h4>常駐雪區</h4>
          <p>主要拍攝地點包含：</p>
          <ul class="about__list about__list--plain">
            <li>日本新潟・越後湯澤</li>
            <li>長野・白馬</li>
            <li>北海道（依雪季安排）</li>
          </ul>
          <p>也接受其他雪場預約拍攝。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter" data-tag="02 — TOWN" style="--h:180vh">
    <div class="chapter__pin">
      <div class="chapter__media">
        <img src="images/town-01.jpg" alt="雪鎮街景">
      </div>
      <div class="chapter__scrim"></div>
      <div class="chapter__content glass-card chapter__content--right">
        <span class="chapter__tag">02 — TOWN</span>
        <h2>Snow Town</h2>
        <p>鏡頭放慢，街角與山影一起被雪蓋成同一種顏色。</p>
      </div>
    </div>
  </section>

  <section class="gallery-section" id="gallery">
    <div class="section-head">
      <h2>完整作品</h2>
      <p>All Work</p>
    </div>
    <div class="gallery-grid gallery-grid--landscape">
      <figure class="gcard glass" data-full="images/action-01.jpg" data-tag="ACTION">
        <img src="images/action-01.jpg" alt="滑雪板騰空動作" loading="lazy">
        <figcaption>Air Grab</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/action-02.jpg" data-tag="ACTION">
        <img src="images/action-02.jpg" alt="雙人跳躍動作" loading="lazy">
        <figcaption>Powder Jump</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/action-03-bw.jpg" data-tag="ACTION">
        <img src="images/action-03-bw.jpg" alt="黑白剪影動作" loading="lazy">
        <figcaption>Silhouette</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/town-01.jpg" data-tag="TOWN">
        <img src="images/town-01.jpg" alt="雪鎮街景" loading="lazy">
        <figcaption>Snow Town</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/action-05.jpg" data-tag="ACTION">
        <img src="images/action-05.jpg" alt="雙人擊掌跳躍動作" loading="lazy">
        <figcaption>High Five</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/action-06.jpg" data-tag="TOWN">
        <img src="images/action-06.jpg" alt="江之電列車交會" loading="lazy">
        <figcaption>Enoden</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/portrait-7202.jpg" data-tag="PORTRAIT">
        <img src="images/portrait-7202.jpg" alt="人像攝影" loading="lazy">
        <figcaption>Portrait</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/lifestyle-01.jpg" data-tag="LIFESTYLE">
        <img src="images/lifestyle-01.jpg" alt="越後湯澤車站人像" loading="lazy">
        <figcaption>Echigo-Yuzawa Station</figcaption>
      </figure>
      <figure class="gcard glass" data-full="images/lifestyle-02.jpg" data-tag="LIFESTYLE">
        <img src="images/lifestyle-02.jpg" alt="街景人像" loading="lazy">
        <figcaption>Backstreet</figcaption>
      </figure>
    </div>

    <div class="gallery-grid gallery-grid--portrait">
      <figure class="gcard gcard--portrait glass" data-full="images/portrait-7203.jpg" data-tag="ACTION">
        <img src="images/portrait-7203.jpg" alt="滑雪板抓板動作" loading="lazy">
        <figcaption>Board Grab</figcaption>
      </figure>
      <figure class="gcard gcard--portrait glass" data-full="images/portrait-0086.jpg" data-tag="ACTION">
        <img src="images/portrait-0086.jpg" alt="滑雪騰空動作" loading="lazy">
        <figcaption>Full Send</figcaption>
      </figure>
      <figure class="gcard gcard--portrait glass" data-full="images/portrait-4187.jpg" data-tag="LIFESTYLE">
        <img src="images/portrait-4187.jpg" alt="恐龍裝合照" loading="lazy">
        <figcaption>Squad</figcaption>
      </figure>
    </div>
  </section>

  <section class="service-plans" id="plans" aria-labelledby="plans-title">
    <div class="section-head">
      <h2 id="plans-title">拍攝方案</h2>
      <p>Photo Session</p>
    </div>

    <div class="plans-grid">
      {% for plan in collections.plans | sortByOrder %}
      <a class="plan-preview glass" href="plans/{{ plan.fileSlug }}.html">
        <img src="{{ plan.data.heroImage }}" alt="{{ plan.data.heroImageAlt }}" loading="lazy">
        <div class="plan-preview__body">
          <span class="plan-preview__eyebrow">{{ plan.data.eyebrowNumber }}</span>
          <h3>{{ plan.data.title }}</h3>
          <p class="plan-preview__en">{{ plan.data.subtitleEn }}</p>
          <p class="plan-preview__desc">{{ plan.data.previewDescription }}</p>
          <span class="plan-preview__link">查看方案內容 →</span>
        </div>
      </a>
      {% endfor %}
    </div>

    <p class="plan-disclaimer">以上三個方案為內容說明，實際人數、時長與報價將依你的需求另行確認。請先填寫需求表單並選擇偏好方案，我們會盡快與你確認細節與正式報價；送出表單不代表預約成立。</p>
  </section>

  <section class="journal glass-panel" id="journal">
    <div class="section-head">
      <h2>文章</h2>
      <p>Journal</p>
    </div>
    <div class="journal__inner">
      <p class="journal__intro">滑雪攝影的準備、比較與雪場攻略，寫給正在規劃日本滑雪行程的你。</p>
      <div class="journal__grid">
        {% for post in collections.posts | reverse %}
        <a class="journal-card glass" href="blog/{{ post.fileSlug }}.html">
          <img src="{{ post.data.previewImage or post.data.heroImage }}" alt="{{ post.data.previewImageAlt or post.data.heroImageAlt }}" loading="lazy">
          <div class="journal-card__body">
            <span class="journal-card__tag">{{ post.data.tag }}</span>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.previewDescription }}</p>
          </div>
        </a>
        {% endfor %}
      </div>
      <a class="journal__more" href="blog/index.html">查看所有文章 →</a>
    </div>
  </section>

  <section class="about glass-panel">
    <div class="section-head">
      <h2>合作夥伴</h2>
      <p>Partners</p>
    </div>
    <div class="partners">
      <div class="partner-card glass">
        <h5>住宿・接駁安排</h5>
        <p>提供雪季住宿規劃、交通接駁與行程安排，讓旅客享有便利、安心的滑雪體驗。</p>
      </div>
      <div class="partner-card glass">
        <h5>滑雪學校</h5>
        <p>與滑雪學校合作，提供課程紀錄、教學攝影、活動拍攝及影像內容創作，捕捉每位滑雪者最精彩的雪季時刻。</p>
      </div>
      <div class="partner-card glass">
        <h5>WHITESPACE Taiwan</h5>
        <p>SnowSurfStudio 為 WHITESPACE Taiwan 合作夥伴。透過我們購買 WHITESPACE 商品，即可享有合作專屬優惠，並提供產品諮詢與選購建議，陪伴你打造理想的滑雪裝備。</p>
      </div>
    </div>
  </section>

  <section class="appointment glass-panel" id="booking">
    <div class="section-head">
      <h2>我要預約</h2>
      <p>Booking</p>
    </div>
    <div class="appointment__inner appointment__inner--wide">
      <div class="booking-wizard" id="bookingWizard">
        <div class="booking-wizard__stepper">
          <div class="booking-wizard__step is-active" data-step="1">
            <span class="booking-wizard__step-num">1</span>
            <span class="booking-wizard__step-label">選擇方案</span>
          </div>
          <div class="booking-wizard__step-line"></div>
          <div class="booking-wizard__step" data-step="2">
            <span class="booking-wizard__step-num">2</span>
            <span class="booking-wizard__step-label">拍攝細節</span>
          </div>
          <div class="booking-wizard__step-line"></div>
          <div class="booking-wizard__step" data-step="3">
            <span class="booking-wizard__step-num">3</span>
            <span class="booking-wizard__step-label">聯絡方式</span>
          </div>
        </div>

        <div class="booking-wizard__body">
          <div class="booking-wizard__main">
            <form id="bookingForm" novalidate>
              <div class="booking-wizard__panel is-active" data-panel="1">
                <h3 class="booking-wizard__panel-title">選擇方案</h3>
                <div class="booking-plan-options">
                  <button type="button" class="booking-plan-option" data-service-value="A 滑雪攝影">
                    <span class="booking-plan-option__icon">📸</span>
                    <span class="booking-plan-option__title">攝影方案</span>
                    <span class="booking-plan-option__desc">適合想留下滑雪回憶的旅客</span>
                  </button>
                  <button type="button" class="booking-plan-option" data-service-value="B 教練課程＋滑雪攝影">
                    <span class="booking-plan-option__icon">🏂</span>
                    <span class="booking-plan-option__title">教練＋攝影方案</span>
                    <span class="booking-plan-option__desc">一次完成學習與紀錄</span>
                  </button>
                  <button type="button" class="booking-plan-option" data-service-value="C 尊榮方案（滑雪教練＋滑雪攝影＋住宿＋滑雪裝備＋接駁）">
                    <span class="booking-plan-option__icon">🤝</span>
                    <span class="booking-plan-option__title">尊榮服務方案</span>
                    <span class="booking-plan-option__desc">從攝影到住宿，一次滿足</span>
                  </button>
                </div>
                <p class="booking-wizard__error" data-error-for="1"></p>
                <div class="booking-wizard__actions">
                  <span></span>
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--next" data-next>下一步 →</button>
                </div>
              </div>

              <div class="booking-wizard__panel" data-panel="2">
                <h3 class="booking-wizard__panel-title">拍攝細節</h3>
                <div class="booking-field">
                  <label for="bookingDate">日期 *</label>
                  <input type="date" id="bookingDate" required>
                </div>
                <div class="booking-field">
                  <label>地點 *</label>
                  <div class="booking-pill-group">
                    <button type="button" class="booking-pill" data-value="白馬">白馬</button>
                    <button type="button" class="booking-pill" data-value="湯澤">湯澤</button>
                  </div>
                </div>
                <div class="booking-field">
                  <label for="bookingPeople">人數 *</label>
                  <input type="number" id="bookingPeople" min="1" value="1" required>
                </div>
                <div class="booking-field">
                  <label for="bookingNotes">拍攝風格或特殊需求（選填）</label>
                  <textarea id="bookingNotes" rows="3" placeholder="例如：自然抓拍為主、希望多拍滑行動態…"></textarea>
                </div>
                <p class="booking-wizard__error" data-error-for="2"></p>
                <div class="booking-wizard__actions">
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--prev" data-prev>← 上一步</button>
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--next" data-next>下一步 →</button>
                </div>
              </div>

              <div class="booking-wizard__panel" data-panel="3">
                <h3 class="booking-wizard__panel-title">聯絡方式</h3>
                <div class="booking-field">
                  <label for="bookingName">姓名 *</label>
                  <input type="text" id="bookingName" required placeholder="王小明">
                </div>
                <div class="booking-field">
                  <label for="bookingEmail">Email *</label>
                  <input type="email" id="bookingEmail" required placeholder="you@example.com">
                </div>
                <div class="booking-field">
                  <label for="bookingLine">LINE ID *</label>
                  <input type="text" id="bookingLine" required placeholder="方便我們用 LINE 聯繫你">
                </div>
                <p class="booking-wizard__error" data-error-for="3"></p>
                <div class="booking-wizard__actions">
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--prev" data-prev>← 上一步</button>
                  <button type="submit" class="booking-wizard__btn booking-wizard__btn--submit">送出預約</button>
                </div>
              </div>
            </form>

            <div class="booking-wizard__confirm" data-panel="confirm" hidden>
              <div class="booking-wizard__confirm-icon">✅</div>
              <h3>已收到你的預約需求！</h3>
              <p>請點下方按鈕前往 LINE，傳送「已填寫」給我們——LINE 會自動幫你打好文字，只要按一下傳送即可，我們會盡快回覆可拍攝檔期與訂金付款資訊。</p>
              <a class="booking-wizard__btn booking-wizard__btn--line" id="bookingLineLink" target="_blank" rel="noopener noreferrer">💬 前往 LINE 傳送「已填寫」</a>
              <p class="booking-wizard__fallback">
                沒有跳轉成功？改用<a href="https://forms.gle/sd9qTAxuh2A3K5FF9" target="_blank" rel="noopener noreferrer">原始需求表單</a>或直接<a href="https://lin.ee/xcqRIdT" target="_blank" rel="noopener noreferrer">加 LINE 詢問</a>。
              </p>
            </div>

            <div class="booking-wizard__error-banner" data-panel="submit-error" hidden>
              <p>送出時發生網路問題，請改用下方連結：</p>
              <a href="https://forms.gle/sd9qTAxuh2A3K5FF9" target="_blank" rel="noopener noreferrer">填寫原始需求表單 →</a>
            </div>

            <p class="appointment__share">拍攝完成後，歡迎在 Instagram 標記 <a href="https://www.instagram.com/snowsurfstudio" target="_blank" rel="noopener noreferrer">@snowsurfstudio</a>，讓更多雪友看到你的滑行瞬間。</p>
          </div>

          <aside class="booking-summary">
            <h4>預約摘要</h4>
            <div class="booking-summary__row"><span>方案</span><strong data-summary="plan">尚未選擇</strong></div>
            <div class="booking-summary__row"><span>日期</span><strong data-summary="date">尚未選擇</strong></div>
            <div class="booking-summary__row"><span>地點</span><strong data-summary="location">尚未選擇</strong></div>
            <div class="booking-summary__row"><span>人數</span><strong data-summary="people">—</strong></div>
            <div class="booking-summary__row"><span>代表人</span><strong data-summary="name">—</strong></div>
          </aside>
        </div>
      </div>

      <div class="policies" id="policies" aria-labelledby="policies-title">
        <div class="section-head"><h2 id="policies-title">安心預約規則</h2><p>Booking Policy</p></div>
        <div class="policy-grid">
          <article class="policy-card glass"><h3>🔒 預約成立</h3><p>日期經確認並收到訂金後，才會正式保留檔期。未於指定期限完成付款，檔期將不另行保留。</p></article>
          <article class="policy-card glass"><h3>↩️ 取消與退款</h3><ul><li>拍攝日前 14 天以上：退還訂金 100%</li><li>拍攝日前 7–13 天：退還訂金 50%</li><li>拍攝日前 6 天內：訂金不予退還</li></ul></article>
          <article class="policy-card glass"><h3>🌨️ 改期與天候</h3><p>拍攝日前 7 天以上可免費改期一次。若遇雪場停業、重大交通中斷或不適合安全拍攝的天候，可協議免費改期或依實際不可退支出後退款。</p></article>
          <article class="policy-card glass"><h3>⏰ 當日提醒</h3><p>遲到不延長原定結束時間；超過 60 分鐘且未聯繫，視同當日取消。安全優先，請依雪場規則與自身能力滑行。</p></article>
        </div>
        <p class="policy-note">完整取消、改期與安全條款會在正式報價／確認時一併提供。</p>
      </div>

      <div class="faq" id="faq" aria-labelledby="faq-title">
        <div class="section-head"><h2 id="faq-title">常見問題</h2><p>FAQ</p></div>
        <div class="faq-list">
          <details class="glass"><summary>📝 填完表單就算預約成功嗎？</summary><p>還不算。表單用於確認拍攝日期、雪場、人數與需求；我們確認檔期並收到訂金後，才會正式保留。</p></details>
          <details class="glass"><summary>🎓 合作學校優惠如何使用？</summary><p>與我們合作的滑雪學校學員享有專屬優惠價格。請在預約時填寫學校名稱，我們確認資格後會提供優惠報價。</p></details>
          <details class="glass"><summary>👥 1 人或 5 人以上可以拍嗎？</summary><p>可以，這類需求會依人數、雪場與拍攝內容提供專屬報價，歡迎先填表單或直接透過 LINE 詢問。</p></details>
          <details class="glass"><summary>☁️ 天氣不好怎麼辦？</summary><p>一般下雪、陰天與低溫仍可能是很棒的拍攝條件；若雪場停業、重大交通中斷或安全條件不允許，我們會協議改期或退款方式。</p></details>
        </div>
      </div>
    </div>
