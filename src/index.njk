{%- set htmlTitle = site.seo.title -%}
{%- set socialTitle = site.seo.title -%}
{%- set canonicalUrl = "https://snowsurfstudio.net/" -%}
{%- set ogImageUrl = "https://snowsurfstudio.net/" + site.seo.ogImage -%}
{%- set ogType = "website" -%}
{%- set assetPrefix = "" -%}
{%- set seo = site.seo -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
{% include "partials/head-meta.njk" %}
<meta name="author" content="SnowSurfStudio">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SnowSurfStudio",
  "alternateName": "日本滑雪攝影 SnowSurfStudio",
  "description": "SnowSurfStudio 提供日本白馬滑雪平面攝影服務，捕捉滑雪旅行中的人像、滑行瞬間與生活紀錄。",
  "knowsAbout": ["滑雪攝影", "日本滑雪攝影", "Snowboard Photography", "Ski Photography"],
  "url": "https://snowsurfstudio.net/",
  "image": "{{ ogImageUrl }}",
  "email": "bbbkai0314@gmail.com",
  "areaServed": [
    { "@type": "Place", "name": "長野・白馬" },
    { "@type": "Place", "name": "北海道" }
  ],
  "sameAs": [
    "https://www.instagram.com/snowsurfstudio",
    "https://www.facebook.com/profile.php?id=61589879631526"
  ],
  "inLanguage": "zh-Hant"
}
</script>
</head>
<body>

{% include "partials/glow.njk" %}

{% include "partials/nav.njk" %}

<aside class="side-card glass" id="sideCard">
  <div class="side-card__dots" id="sideDots"></div>
  <div class="side-card__label" id="sideLabel">HERO</div>
</aside>

<main id="top">

  <section class="chapter" data-tag="HERO" style="--h:100vh">
    <div class="chapter__pin">
      <div class="chapter__media chapter__media--crossfade">
        <img class="hero-fade hero-fade--a" src="{{ site.heroImage }}" alt="{{ site.heroImageAlt }}">
        <img class="chapter__media-img--summer hero-fade hero-fade--b" src="{{ site.heroImageSecondary }}" alt="{{ site.heroImageSecondaryAlt }}">
      </div>
      <div class="chapter__scrim chapter__scrim--hero-left hero-fade hero-fade--a"></div>
      <div class="chapter__scrim chapter__scrim--hero-right hero-fade hero-fade--b"></div>
      <div class="hero-fade hero-fade--a">
        <div class="chapter__content chapter__content--hero">
          <p class="eyebrow">Snow photographer · 滑雪攝影</p>
          <h1>snowsurfstudio</h1>
          <p class="hero__booking">2026/27 日本滑雪攝影服務｜Snowboard &amp; Ski</p>
          <p class="chapter__location">{{ site.heroLocationLine }}</p>
          <p class="chapter__lead">SnowSurfStudio 在日本白馬，<br>用最自然的方式，記錄你在雪上的每一刻。<br><br>不管是一個人、兩個人，<br>還是一家人、一群朋友，<br>都替你留下真正投入雪季、享受滑雪的樣子。</p>
          <p class="chapter__sub">2026 / 27 Season &middot; @snowsurfstudio</p>
        </div>
      </div>
      <div class="hero-fade hero-fade--b">
        <div class="chapter__content chapter__content--hero chapter__content--right">
          <p class="eyebrow">人生轉場攝影師 · Life in Transition</p>
          <h1 class="chapter__content--nowrap">Life in Transition</h1>
          <p class="hero__booking">人生轉場記錄者</p>
          <p class="chapter__lead">人生很多轉折，卻很少有一張照片留住那個瞬間。離職的那天、畢業典禮後的擁抱、搬進新城市的第一個早晨——我們陪你走進人生正在翻篇的那一刻，把「正在轉變中的自己」好好留下來。</p>
        </div>
      </div>
      <div class="scroll-cue">SCROLL</div>
    </div>
  </section>

  <section class="life-chapters" id="life-chapters" data-tag="CHAPTERS" aria-labelledby="life-chapters-title">
    <div class="life-chapters__head">
      <div class="life-chapters__heading">
        <p class="life-chapters__eyebrow">Life Chapters</p>
        <h2 id="life-chapters-title">LIFE CHAPTERS</h2>
      </div>
    </div>
    <div class="chapters-grid">
      <article class="chapter-card chapter-card--carousel" data-line-url="https://lin.ee/xcqRIdT">
        <div class="chapter-card__media chapter-card__media--carousel" aria-hidden="true">
          <img class="chapter-card__slide" src="images/my-own-way-01.jpg" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/my-own-way-02.jpg" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/my-own-way-03.jpg" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/my-own-way-04.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/my-own-way-05.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/my-own-way-06.png" alt="" loading="lazy">
        </div>
        <div class="chapter-card__scrim"></div>
        <div class="chapter-card__body">
          <p class="chapter-card__title">MY OWN WAY</p>
          <p class="chapter-card__subtitle">A trip with myself</p>
        </div>
        <button class="chapter-card__carousel-next" type="button" aria-label="查看下一張 MY OWN WAY 圖文">
          <span class="chapter-card__carousel-action" aria-hidden="true">→</span>
        </button>
      </article>
      <article class="chapter-card chapter-card--carousel" data-line-url="https://lin.ee/xcqRIdT">
        <div class="chapter-card__media chapter-card__media--carousel" aria-hidden="true">
          <img class="chapter-card__slide" src="images/chapter-couple-01.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-couple-02.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-couple-03.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-couple-04.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-couple-05.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-couple-06.png" alt="" loading="lazy">
        </div>
        <div class="chapter-card__scrim"></div>
        <div class="chapter-card__body">
          <p class="chapter-card__title">COUPLE</p>
          <p class="chapter-card__subtitle">A trip together</p>
        </div>
        <button class="chapter-card__carousel-next" type="button" aria-label="查看下一張 COUPLE 圖文">
          <span class="chapter-card__carousel-action" aria-hidden="true">→</span>
        </button>
      </article>
      <article class="chapter-card chapter-card--carousel" data-line-url="https://lin.ee/xcqRIdT">
        <div class="chapter-card__media chapter-card__media--carousel" aria-hidden="true">
          <img class="chapter-card__slide" src="images/chapter-family-01.png" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-family-02.jpg" alt="" loading="lazy">
          <img class="chapter-card__slide" src="images/chapter-family-03.png" alt="" loading="lazy">
        </div>
        <div class="chapter-card__scrim"></div>
        <div class="chapter-card__body">
          <p class="chapter-card__title">FAMILY</p>
          <p class="chapter-card__subtitle">A season to remember</p>
        </div>
        <button class="chapter-card__carousel-next" type="button" aria-label="查看下一張 FAMILY 圖文">
          <span class="chapter-card__carousel-action" aria-hidden="true">→</span>
        </button>
      </article>
    </div>
  </section>

  <section class="gallery-section" id="gallery" data-tag="GALLERY">
    <div class="section-head">
      <h2>完整作品</h2>
      <p>All Work</p>
    </div>
    <div class="gallery-grid gallery-grid--landscape">
      {% for item in gallery | byOrientation("landscape") %}
      <figure class="gcard glass" data-full="{{ item.image }}" data-tag="{{ item.tag }}">
        <img src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
        <figcaption>{{ item.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>

    <div class="gallery-grid gallery-grid--portrait">
      {% for item in gallery | byOrientation("portrait") %}
      <figure class="gcard gcard--portrait glass" data-full="{{ item.image }}" data-tag="{{ item.tag }}">
        <img src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
        <figcaption>{{ item.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>

  <section class="service-plans" id="plans" data-tag="PLANS" aria-labelledby="plans-title">
    <div class="section-head">
      <h2 id="plans-title">拍攝方案</h2>
      <p>Photo Session</p>
      <a class="journal__more" href="plans/life-transition.html">人生轉場攝影方案 →</a>
    </div>

    <div class="plans-grid">
      {% for plan in collections.plans | sortByOrder %}
      <a class="plan-preview glass" href="plans/{{ plan.fileSlug }}.html">
        <img src="{{ plan.data.heroImage }}" alt="{{ plan.data.heroImageAlt }}" loading="lazy"{% if plan.data.previewImagePosition %} style="object-position:{{ plan.data.previewImagePosition }};"{% endif %}>
        <div class="plan-preview__body">
          <h3>{{ plan.data.title }}</h3>
          <p class="plan-preview__desc">{{ plan.data.previewDescription }}</p>
          <span class="plan-preview__link">查看方案內容 →</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="journal glass-panel" id="journal" data-tag="JOURNAL">
    <div class="section-head">
      <h2>滑雪日誌</h2>
      <p>Journal</p>
    </div>
    <div class="journal__inner">
      <p class="journal__intro">滑雪攝影的準備、Snowboard 與 Ski 拍攝比較、雪場攻略，寫給正在規劃日本滑雪行程的你。</p>
      <div class="journal__grid">
        {% for post in collections.posts | reverse %}
        <a class="journal-card journal-card--text glass" href="blog/{{ post.fileSlug }}.html">
          <div class="journal-card__body">
            <span class="journal-card__tag">{{ post.data.tag }}</span>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.previewDescription }}</p>
          </div>
        </a>
        {% endfor %}
      </div>
      <a class="journal__more" href="blog/index.html">查看所有文章 →</a>
    </div>
  </section>

  <section class="about glass-panel" id="partners" data-tag="PARTNERS">
    <div class="section-head">
      <h2>合作夥伴</h2>
      <p>Partners</p>
    </div>
    <div class="partners">
      <div class="partner-card glass">
        <h5>協助住宿・接駁安排</h5>
        <p>提供雪季住宿規劃、交通接駁與行程安排，讓旅客享有便利、安心的滑雪體驗。</p>
      </div>
      <div class="partner-card glass">
        <h5>滑雪學校</h5>
        <p>與滑雪學校合作，提供課程紀錄、教學攝影、活動拍攝及影像內容創作，捕捉每位滑雪者最精彩的雪季時刻。</p>
      </div>
      <div class="partner-card glass">
        <h5>WHITESPACE Taiwan</h5>
        <p>SnowSurfStudio 為 WHITESPACE Taiwan 合作夥伴。透過我們購買 WHITESPACE 商品，即可享有合作專屬優惠，並提供產品諮詢與選購建議，陪伴你打造理想的滑雪裝備。</p>
      </div>
    </div>
  </section>

  {% set activeNews = site.newsItems | activeItem %}
  {% if activeNews %}
  <section class="news-banner" id="news" data-tag="NEWS" aria-labelledby="news-title">
    <div class="news-banner__card glass">
      <span class="news-banner__eyebrow">最新消息 · NEWS</span>
      <h2 id="news-title">{{ activeNews.title }}</h2>
      <ul class="news-banner__list">
        {% for point in activeNews.copy %}
        <li>{{ point }}</li>
        {% endfor %}
      </ul>
      <a class="news-banner__btn appointment__btn glass" href="#booking">{{ activeNews.buttonLabel }}</a>
    </div>
  </section>
  {% endif %}

  <section class="appointment glass-panel" id="booking" data-tag="BOOKING">
    <div class="section-head">
      <h2>我要預約</h2>
      <p>Booking</p>
    </div>
    <div class="appointment__inner">
      <a class="booking-notice glass" href="blog/ski-lesson-photography-guide.html">
        <span class="booking-notice__icon" aria-hidden="true">📋</span>
        <span class="booking-notice__text">預約前必讀：滑雪教學＋平面攝影服務說明與注意事項</span>
        <span class="booking-notice__arrow" aria-hidden="true">→</span>
      </a>
      <div class="booking-wizard" id="bookingWizard">
        <div class="booking-wizard__stepper">
          <div class="booking-wizard__step is-active" data-step="1">
            <span class="booking-wizard__step-num">1</span>
            <span class="booking-wizard__step-label">拍攝細節</span>
          </div>
          <div class="booking-wizard__step-line"></div>
          <div class="booking-wizard__step" data-step="2">
            <span class="booking-wizard__step-num">2</span>
            <span class="booking-wizard__step-label">選擇方案</span>
          </div>
          <div class="booking-wizard__step-line"></div>
          <div class="booking-wizard__step" data-step="3">
            <span class="booking-wizard__step-num">3</span>
            <span class="booking-wizard__step-label">聯絡方式</span>
          </div>
        </div>

        <div class="booking-wizard__body">
          <div class="booking-wizard__main">
            <form id="bookingForm" novalidate>
              <div class="booking-wizard__panel is-active" data-panel="1">
                <h3 class="booking-wizard__panel-title">拍攝細節</h3>
                <div class="booking-field">
                  <label>日期 *</label>
                  <div class="booking-calendar" id="bookingCalendar">
                    <p class="booking-calendar__banner">🔥 熱門日期陸續被搶訂中，越晚預約可選日期越少</p>
                    <div class="booking-calendar__head">
                      <button type="button" class="booking-calendar__nav" data-cal-prev aria-label="上個月">‹</button>
                      <span class="booking-calendar__title" data-cal-title></span>
                      <button type="button" class="booking-calendar__nav" data-cal-next aria-label="下個月">›</button>
                    </div>
                    <div class="booking-calendar__weekdays">
                      <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
                    </div>
                    <div class="booking-calendar__grid" data-cal-grid></div>
                    <p class="booking-calendar__hint" data-cal-hint hidden></p>
                    <div class="booking-calendar__legend">
                      <span class="booking-calendar__legend-item"><i class="booking-calendar__dot booking-calendar__dot--open"></i>可預約</span>
                      <span class="booking-calendar__legend-item"><i class="booking-calendar__dot booking-calendar__dot--selected"></i>已選擇</span>
                      <span class="booking-calendar__legend-item"><i class="booking-calendar__dot booking-calendar__dot--full"></i>已被預約</span>
                    </div>
                    <p class="booking-calendar__selected" data-cal-selected>尚未選擇日期</p>
                  </div>
                </div>
                <div class="booking-field">
                  <label>地點 *</label>
                  <div class="booking-pill-group">
                    <button type="button" class="booking-pill" data-value="白馬">白馬</button>
                  </div>
                </div>
                <div class="booking-field">
                  <label for="bookingPeople">人數 *</label>
                  <input type="number" id="bookingPeople" min="1" value="1" required>
                </div>
                <div class="booking-field">
                  <label for="bookingNotes">拍攝風格或特殊需求（選填）</label>
                  <textarea id="bookingNotes" rows="3" placeholder="例如：自然抓拍為主、希望多拍滑行瞬間…"></textarea>
                </div>
                <p class="booking-wizard__error" data-error-for="1"></p>
                <div class="booking-wizard__actions">
                  <span></span>
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--next" data-next>下一步 →</button>
                </div>
              </div>

              <div class="booking-wizard__panel" data-panel="2">
                <h3 class="booking-wizard__panel-title">選擇方案</h3>
                <div class="booking-plan-options">
                  <button type="button" class="booking-plan-option" data-service-value="A 人生轉場攝影">
                    <span class="booking-plan-option__icon">🌅</span>
                    <span class="booking-plan-option__title">人生轉場攝影方案</span>
                    <span class="booking-plan-option__desc">離職、分手、畢業——為正在轉變的自己留下一張照片</span>
                  </button>
                  <button type="button" class="booking-plan-option" data-service-value="B 陪伴滑雪方案">
                    <span class="booking-plan-option__icon">❄️</span>
                    <span class="booking-plan-option__title">陪伴滑雪方案</span>
                    <span class="booking-plan-option__desc">一個人滑雪找不到人？我們陪你把回憶留下來</span>
                  </button>
                  <button type="button" class="booking-plan-option" data-service-value="C 滑雪教練＋滑雪攝影">
                    <span class="booking-plan-option__icon">🏂</span>
                    <span class="booking-plan-option__title">滑雪教練＋攝影方案</span>
                    <span class="booking-plan-option__desc">一次完成學習與紀錄</span>
                  </button>
                  <button type="button" class="booking-plan-option" data-service-value="D 尊榮方案（滑雪教練＋滑雪攝影＋住宿＋滑雪裝備＋接駁）">
                    <span class="booking-plan-option__icon">🤝</span>
                    <span class="booking-plan-option__title">尊榮服務方案</span>
                    <span class="booking-plan-option__desc">從攝影到住宿，一次滿足</span>
                  </button>
                </div>
                <p class="booking-wizard__error" data-error-for="2"></p>
                <div class="booking-wizard__actions">
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--prev" data-prev>← 上一步</button>
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--next" data-next>下一步 →</button>
                </div>
              </div>

              <div class="booking-wizard__panel" data-panel="3">
                <h3 class="booking-wizard__panel-title">聯絡方式</h3>
                <div class="booking-field">
                  <label for="bookingName">姓名 *</label>
                  <input type="text" id="bookingName" required placeholder="王小明">
                </div>
                <div class="booking-field">
                  <label for="bookingEmail">Email *</label>
                  <input type="email" id="bookingEmail" required placeholder="you@example.com">
                </div>
                <div class="booking-field">
                  <label for="bookingLine">LINE ID *</label>
                  <input type="text" id="bookingLine" required placeholder="方便我們用 LINE 聯繫你">
                </div>
                <p class="booking-wizard__error" data-error-for="3"></p>
                <div class="booking-wizard__actions">
                  <button type="button" class="booking-wizard__btn booking-wizard__btn--prev" data-prev>← 上一步</button>
                  <button type="submit" class="booking-wizard__btn booking-wizard__btn--submit">送出預約</button>
                </div>
              </div>
            </form>

            <div class="booking-wizard__confirm" data-panel="confirm" hidden>
              <div class="booking-wizard__confirm-icon">✅</div>
              <h3>已收到你的預約需求！</h3>
              <p>正在為你開啟 LINE，請點「加入」加我們為好友，我們會盡快回覆可拍攝檔期與訂金付款資訊。</p>
              <a class="booking-wizard__line-link" href="https://lin.ee/xcqRIdT" target="_blank" rel="noopener noreferrer">沒有自動跳轉？點此前往 LINE</a>
              <p class="booking-wizard__fallback">
                無法使用 LINE？改用<a href="https://forms.gle/sd9qTAxuh2A3K5FF9" target="_blank" rel="noopener noreferrer">原始需求表單</a>。
              </p>
            </div>

            <div class="booking-wizard__error-banner" data-panel="submit-error" hidden>
              <p>送出時發生網路問題，請改用下方連結：</p>
              <a href="https://forms.gle/sd9qTAxuh2A3K5FF9" target="_blank" rel="noopener noreferrer">填寫原始需求表單 →</a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>


  {% include "partials/footer.njk" %}

</main>

{% include "partials/line-float.njk" %}

<div class="lightbox" id="lightbox">
  <button class="lightbox__close" id="lightboxClose" aria-label="Close">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Previous">&#8249;</button>
  <img class="lightbox__img" id="lightboxImg" src="" alt="">
  <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Next">&#8250;</button>
  <div class="lightbox__meta">
    <span id="lightboxTag"></span>
    <span id="lightboxCount"></span>
  </div>
</div>

<script src="js/script.js?v={{ assetVersion }}"></script>
<script src="js/tracking.js?v={{ assetVersion }}"></script>
<script>window.SSF_BLOCKED_DATES = {{ blockedDates | dump | safe }};</script>
<script src="js/booking-form.js?v={{ assetVersion }}"></script>
</body>
</html>
