{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(npm run build)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Edit(src/**)",
      "Edit(automation/**)",
      "Edit(12_Brand_Knowledge/**)",
      "Edit(13_SOP_Workflows/**)"
    ],
    "ask": [
      "Bash(git merge*)",
      "mcp__github__merge_pull_request",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__create_draft",
      "mcp__Google_Calendar__create_event",
      "mcp__Google_Calendar__update_event",
      "mcp__Google_Calendar__delete_event",
      "mcp__Notion__notion-create-pages",
      "mcp__Notion__notion-update-page",
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__share_file"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*credentials*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Google_Drive__trash_file",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-dangerous-bash.sh\"",
            "timeout": 10,
            "statusMessage": "檢查指令是否踩到紅線…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/audit-log.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
